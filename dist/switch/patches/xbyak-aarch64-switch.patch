diff --git a/src/util_impl_switch.h b/src/util_impl_switch.h
new file mode 100644
--- /dev/null
+++ b/src/util_impl_switch.h
@@ -0,0 +1,52 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+#ifndef __SWITCH__
+#error "util_impl_switch.h requires __SWITCH__"
+#endif
+
+#include <stdint.h>
+
+#include "xbyak_aarch64_err.h"
+#include "xbyak_aarch64_util.h"
+
+namespace Xbyak_aarch64 {
+namespace util {
+
+class CpuInfoSwitch : public CpuInfo {
+public:
+  CpuInfoSwitch() {
+    init();
+    cacheInfo_.midr_el1 = 0x411FD070;
+    setNumCores();
+    setHwCap();
+    setCacheHierarchy();
+    setImplementer();
+  }
+
+private:
+  void setNumCores() {
+    numCores_[0] = numCores_[1] = 4;
+  }
+
+  void setHwCap() {
+    type_ |= (Type)XBYAK_AARCH64_HWCAP_FP;
+    type_ |= (Type)XBYAK_AARCH64_HWCAP_ADVSIMD;
+    type_ |= (Type)XBYAK_AARCH64_HWCAP_CRC;
+  }
+
+  void setCacheHierarchy() {
+    cacheInfo_.levelCache[0].type = SeparateCache;
+    cacheInfo_.levelCache[0].size[0] = 48 * 1024;
+    cacheInfo_.levelCache[0].size[1] = 32 * 1024;
+    cacheInfo_.levelCache[0].sharingCores[0] = 1;
+    cacheInfo_.levelCache[0].sharingCores[1] = 1;
+    cacheInfo_.levelCache[1].type = UnifiedCache;
+    cacheInfo_.levelCache[1].size[2] = 2 * 1024 * 1024;
+    cacheInfo_.levelCache[1].sharingCores[2] = 4;
+    lastDataCacheLevel_ = 2;
+  }
+};
+
+} // namespace util
+} // namespace Xbyak_aarch64
